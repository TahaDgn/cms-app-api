{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@cms-app/adapters": [
        "libs/adapters/src"
      ],
      "@cms-app/adapters/*": [
        "libs/adapters/src/*"
      ],
      "@cms-app/interfaces": [
        "libs/interfaces/src"
      ],
      "@cms-app/interfaces/*": [
        "libs/interfaces/src/*"
      ],
      "@cms-app/constants": [
        "libs/constants/src"
      ],
      "@cms-app/constants/*": [
        "libs/constants/src/*"
      ],
      "@cms-app/event-definitions": [
        "libs/event-definitions/src"
      ],
      "@cms-app/event-definitions/*": [
        "libs/event-definitions/src/*"
      ],
      "@cms-app/shared-utils": [
        "libs/shared-utils/src"
      ],
      "@cms-app/shared-utils/*": [
        "libs/shared-utils/src/*"
      ],
      "@cms-app/saga": [
        "libs/saga/src"
      ],
      "@cms-app/saga/*": [
        "libs/saga/src/*"
      ]
    }
  }
}